// Cloudflare Workers deployment (free plan): static client + one Durable Object running the game server.
// Deploy:  npx wrangler login  &&  npm run deploy:cloudflare     (details: docs/DEPLOYMENT.md)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tank-clash",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-06-01",
  "build": {
    // Runs before every deploy/dev: builds the browser client into client/dist.
    "command": "npm run build -w client",
  },
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    // /join/CODE invite links open the app.
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; everything else is served straight from the static asset cache.
    "run_worker_first": ["/ws", "/health"],
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "TankClashServer" }],
  },
  // Free plan Durable Objects must use the SQLite storage backend (this game stores nothing on disk anyway).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TankClashServer"] }],
  "vars": {
    "NODE_ENV": "production",
    // Optional extra origins (e.g. a custom domain): "https://tank.example.com,https://other.example".
    // Not needed for the default *.workers.dev URL — same-origin connections are always allowed.
    "ALLOWED_ORIGINS": "",
    "LOG_LEVEL": "warn",
  },
  "observability": { "enabled": true },
}
